# Copy to .env and adjust. All variables can also be set in the environment.

# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017
# Database name (default: godo)
MONGO_DB=godo
# Secret used to sign login tokens; at least 32 characters (required).
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
# How long a login stays valid (default: 168h = 7 days)
TOKEN_TTL=168h
# HTTP port (default: 8080)
PORT=8080
# Comma-separated frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173
